ARTIST_REQUEST_MAX_PAGE_SIZE=20
REQUEST_PAGE_DEFAULT_SIZE=30
USER_PAGE_DEFAULT_SIZE=200
USER_REQUEST_MAX_PAGE_SIZE=200

# Catalog Command Service
