# Outbox
OUTBOX_RETRY_INITIAL_DELAY_MS=1500
OUTBOX_RETRY_MAX_DELAY_MS=60000
OUTBOX_RETRY_BACKOFF_MULTIPLIER=1.3
OUTBOX_RETRY_JITTER_INTENSITY_PERCENTAGE=0.1
OUTBOX_RETRY_MAX_ATTEMPTS=7
OUTBOX_PROCESSOR_JOB_DELAY_MS=3500
OUTBOX_PROCESSING_TIMEOUT=1m

# Logging
ROOT_LOG_LEVEL=INFO
SERVICE_LOG_LEVEL=DEBUG
OUTBOX_LOG_LEVEL=TRACE