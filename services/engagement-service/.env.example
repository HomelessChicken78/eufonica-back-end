# Database
DB_URL=jdbc:postgresql://localhost:5432/eufonica_engagement
DB_USERNAME=myuser
DB_PASSWORD=changeme
DDL_AUTO=validate

# Server
SERVER_PORT=8084

## Servlet
CONTEXT_PATH=/app

# Engagement
## Playlists
PLAYLIST_ENTRY_POSITION_GAP=1000

### Search
PLAYLIST_PAGE_MAX_SIZE=50
PLAYLIST_DEFAULT_SORT_ORDER:LIKES_DESC
PLAYLIST_PAGE_DEFAULT_SIZE=50
PLAYLIST_ENTRY_DEFAULT_SORT_ORDER=POSITION
PLAYLIST_ENTRY_PAGE_MAX_SIZE=50
PLAYLIST_ENTRY_PAGE_DEFAULT_SIZE=50

## Song
### Listen
LISTEN_MIN_SEC_PLAYED_CAP=3
LISTEN_MIN_SEC_PLAYED_PERCENTAGE=0.5
LISTEN_COOLDOWN_SECONDS=60
LISTEN_PAGE_MAX_SIZE=50
LISTEN_PAGE_DEFAULT_SIZE=50

# CQRS
## Kafka
### Topics
SONG_TOPIC_NAME=song.events
APP_USER_TOPIC_NAME=appuser.events
SONG_ENGAGEMENT_TOPIC_NAME=song-engagement.events
SONG_ENGAGEMENT_TOPIC_PARTITIONS=2
SONG_ENGAGEMENT_TOPIC_REPLICAS=1

### Producer
KAFKA_KEY_SERIALIZER=org.apache.kafka.common.serialization.StringSerializer
KAFKA_VALUE_SERIALIZER=org.apache.kafka.common.serialization.StringSerializer
KAFKA_PRODUCER_REQUEST_TIMEOUT_MS=5000
KAFKA_PRODUCER_DELIVERY_TIMEOUT_MS=10000

### Consumer & Listener
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_CONSUMER_GROUP_ID=engagement-service-group
KAFKA_AUTO_OFFSET_RESET=earliest
KAFKA_LISTENER_ACK_MODE=RECORD

# Logging
ROOT_LOG_LEVEL=INFO
SERVICE_LOG_LEVEL=INFO
CONTROLLER_LOG_LEVEL=INFO
CONSUMER_LOG_LEVEL=INFO
EVENT_PROCESSING_LOG_LEVEL=INFO