# Database
DB_URL=jdbc:postgresql://localhost:5432/mydb
DB_USERNAME=myuser
DB_PASSWORD=changeme
DDL_AUTO=update

# Server
SERVER_PORT=8094

## Servlet
CONTEXT_PATH=/mycontextpath

# Engagement
## Playlists
PLAYLIST_ENTRY_POSITION_GAP=1000

### Search
PLAYLIST_PAGE_MAX_SIZE=50
PLAYLIST_DEFAULT_SORT_ORDER:LIKES_DESC
PLAYLIST_PAGE_DEFAULT_SIZE=50
PLAYLIST_ENTRY_DEFAULT_SORT_ORDER=POSITION
PLAYLIST_ENTRY_PAGE_MAX_SIZE=50
PLAYLIST_ENTRY_PAGE_DEFAULT_SIZE=50

# CQRS
## Kafka
### Consumer & Listener
KAFKA_BOOTSTRAP_SERVERS=localhost:9093
KAFKA_CONSUMER_GROUP_ID=my-consumer-group-example
KAFKA_AUTO_OFFSET_RESET=latest
KAFKA_LISTENER_ACK_MODE=MANUAL

### Topics
SONG_TOPIC_NAME=album.song.topic
APP_USER_TOPIC_NAME=appuser.topic

# Logging
ROOT_LOG_LEVEL=INFO
SERVICE_LOG_LEVEL=INFO
CONTROLLER_LOG_LEVEL=INFO
CONSUMER_LOG_LEVEL=INFO
EVENT_PROCESSING_LOG_LEVEL=INFO