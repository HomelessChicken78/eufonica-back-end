# The following envs should/can be included in the .env of services that use this module
# CQRS
## Outbox
### Default: 30. Optional env that defines after how much time an event stuck in 'PROCESSING' is considered stale.
### Duration format ISO-8601 or shorthand spring
OUTBOX_PROCESSING_TIMEOUT=30s

### Default: 1000. Defines the interval in milliseconds between one execution and another of the outbox scheduled job
OUTBOX_PROCESSOR_JOB_DELAY_MS=1000

### Default: 5. Defines after how many failed attempts the event is marked as 'FAILED'
OUTBOX_RETRY_MAX_ATTEMPTS=5

### Default: 1000. Defines the initial delay in milliseconds from which the exponential back-off has to start from
OUTBOX_RETRY_INITIAL_DELAY_MS=1000

### Default: 30000. Defines the maximum delay in milliseconds from one retry and another, regardless of the back-off
OUTBOX_RETRY_MAX_DELAY_MS=30000

### Default: 1.5. Defines how fast the delay between one retry and the next grows exponentially. Set to 1.0 to disable.
### Values less than 1.0 will make the delay shorter with each retry.
OUTBOX_RETRY_BACKOFF_MULTIPLIER=1.5

### Default: 0.2. Decimal number representing a percentage (1=100%, 0.2=20%) that defines the percentual amount of jitter.
### The jitter is a multiplier applied to the delay. The multiplier is a number between this env and negative of this env.
### It serves the purpose of avoiding that failed events are all re-attempted at the same time (thundering herd).
OUTBOX_RETRY_JITTER_INTENSITY_PERCENTAGE=0.2