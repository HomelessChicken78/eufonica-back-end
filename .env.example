# Database
DB_USER=myuser
DB_PASSWORD=changeme
DB_AUTH_NAME=auth

# Kafka
## Kafka Node Configuration
KAFKA_NODE_ID=0
KAFKA_PROCESS_ROLES=broker,controller

## Kafka Network Configuration
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
KAFKA_PORT=9092

## Kafka Controller Configuration
KAFKA_CONTROLLER_LISTENER_NAMES=CONTROLLER
KAFKA_CONTROLLER_LISTENER_PORT=9093
KAFKA_CONTROLLER_QUORUM_VOTERS=0@kafka-broker:9093

## Kafka Cluster Configuration
KAFKA_CLUSTER_ID=REPLACE_WITH_CLUSTER_ID

## Kafka Topic Configuration
KAFKA_AUTO_CREATE_TOPICS_ENABLE=false
